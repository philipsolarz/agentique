# AgentMCP Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Google AI Configuration (REQUIRED)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# A2A Test Agent Configuration
# ============================================================================
# Server settings
A2A_HOST=0.0.0.0
A2A_PORT=9000
A2A_PROTOCOL=http

# Base URL (important for Docker - uses internal Docker network hostname)
# For local development: http://localhost:9000
# For Docker: http://a2a-test-agent:9000
A2A_BASE_URL=http://a2a-test-agent:9000

# Model configuration
# Options: gemini-2.0-flash, gemini-2.5-flash, gemini-2.0-flash-exp
ADK_MODEL=gemini-2.0-flash

# Development mode - enables auto-reload (set to 1 to enable)
# A2A_RELOAD=0

# Custom agent card path (optional)
# A2A_AGENT_CARD=/path/to/agent-card.json

# ============================================================================
# MCP Server Configuration
# ============================================================================
# Transport mode: stdio or http
AGENTIQUE_TRANSPORT=http

# Server settings (for HTTP mode)
AGENTIQUE_HOST=0.0.0.0
AGENTIQUE_PORT=8000

# Agent routing configuration
# Format: name=url|skill1,skill2,skill3
# The URL must point to the A2A agent's endpoint
AGENTIQUE_AGENTS=root=http://a2a-test-agent:9000|calculator,data_processing,text_manipulation,info_retrieval
