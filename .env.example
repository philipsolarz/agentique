# Dev-only configuration for the scenarios/ harness (live Anthropic runs).
# Copy this file to .env and fill in both values. .env is gitignored.
# Used ONLY by the throwaway scenarios harness — never by the shipped
# agentique package (which stays zero-dependency).

# Your Anthropic API key. The Anthropic SDK reads this automatically.
ANTHROPIC_API_KEY=

# A current Anthropic model id. The framework refuses to guess one — confirm the
# active id in the Anthropic console/dashboard and paste it here.
ANTHROPIC_MODEL=
